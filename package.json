{
  "name": "resume-generator",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --check ./{app,tests}/**/*.{ts,tsx}",
    "format-run": "npx prettier --write ./{app,tests}/**/*.{ts,tsx}",
    "deploy": "yarn build && npx wrangler pages deploy build/client"
  },
  "dependencies": {
    "@remix-run/node": "^2.17.1",
    "@remix-run/react": "^2.17.1",
    "date-fns": "^3.6.0",
    "isbot": "^5.1.31",
    "js-yaml": "^4.1.0",
    "linkify-string": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.20",
    "vite-tsconfig-paths": "^4.3.2",
    "wrangler": "^3.114.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
